  "summary_base_url": "https://api.openai.com/v1",
  "summary_api_key": null,
  "summary_model": "gpt-4o-mini",
  "summary_default_tone": "analytical",
  "summary_default_template": "quick_brief",
  "summary_timeout_seconds": 30
